<%- include('../partials/header', { pageTitle: project.name, activeView: 'board' }) %>

<!-- Board Toolbar (Filter, Search & Create Task) -->
<div class="board-filters">
  <!-- Search/Filter Form -->
  <form action="/projects/<%= project._id %>" method="GET" class="filter-group search-group" style="display: flex; flex-wrap: wrap; gap: 16px; width: 100%; align-items: flex-end;">
    
    <div class="filter-group" style="min-width: 200px;">
      <label for="filter-priority-select"><i class="fa-solid fa-triangle-exclamation"></i> Priority</label>
      <select name="priority" id="filter-priority-select" onchange="this.form.submit()">
        <option value="">All Priorities</option>
        <option value="Low" <%= filters.priority === 'Low' ? 'selected' : '' %>>Low</option>
        <option value="Medium" <%= filters.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
        <option value="High" <%= filters.priority === 'High' ? 'selected' : '' %>>High</option>
      </select>
    </div>

    <div class="filter-group" style="flex-grow: 1; min-width: 250px;">
      <label for="filter-search-input"><i class="fa-solid fa-magnifying-glass"></i> Search Tasks</label>
      <input type="text" name="search" id="filter-search-input" placeholder="Type title or description..." value="<%= filters.search %>">
    </div>

    <div style="display: flex; gap: 8px;">
      <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-filter"></i> Apply
      </button>
      <a href="/projects/<%= project._id %>" class="btn btn-secondary">
        <i class="fa-solid fa-rotate-left"></i> Reset
      </a>
    </div>
  </form>
  
  <!-- Trigger Task Creation Modal -->
  <button class="btn btn-primary" id="btn-open-task-modal" style="margin-left: auto;">
    <i class="fa-solid fa-plus"></i> Create Task
  </button>
</div>

<!-- Project Meta Banner -->
<div class="project-info-banner" style="background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px 24px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
  <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 4px;"><%= project.description || 'No description provided.' %></p>
  <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-light); text-transform: uppercase;">
    Project Manager: <%= project.owner ? project.owner.username : 'Unknown' %>
  </span>
</div>

<!-- Kanban Board Layout -->
<div class="kanban-board">
  <!-- Column 1: To Do -->
  <div class="kanban-column">
    <div class="column-header">
      <div class="title-row">
        <span class="column-dot dot-todo"></span>
        <h3>To Do</h3>
        <span class="column-count"><%= todoTasks.length %></span>
      </div>
    </div>
    <div class="column-cards">
      <% if (todoTasks.length === 0) { %>
        <div class="empty-state">No tasks to do.</div>
      <% } else { %>
        <% todoTasks.forEach(task => { %>
          <%- include('task_card', { task }) %>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Column 2: In Progress -->
  <div class="kanban-column">
    <div class="column-header">
      <div class="title-row">
        <span class="column-dot dot-progress"></span>
        <h3>In Progress</h3>
        <span class="column-count"><%= progressTasks.length %></span>
      </div>
    </div>
    <div class="column-cards">
      <% if (progressTasks.length === 0) { %>
        <div class="empty-state">No tasks in progress.</div>
      <% } else { %>
        <% progressTasks.forEach(task => { %>
          <%- include('task_card', { task }) %>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Column 3: Completed -->
  <div class="kanban-column">
    <div class="column-header">
      <div class="title-row">
        <span class="column-dot dot-completed"></span>
        <h3>Completed</h3>
        <span class="column-count"><%= completedTasks.length %></span>
      </div>
    </div>
    <div class="column-cards">
      <% if (completedTasks.length === 0) { %>
        <div class="empty-state">No tasks completed.</div>
      <% } else { %>
        <% completedTasks.forEach(task => { %>
          <%- include('task_card', { task }) %>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<!-- Task Creation Modal -->
<div class="modal" id="create-task-modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Create New Task</h2>
      <button class="modal-close" onclick="toggleModal('create-task-modal')">&times;</button>
    </div>
    <form action="/tasks" method="POST">
      <!-- Hidden field pointing to active project -->
      <input type="hidden" name="project" value="<%= project._id %>">

      <div class="form-group">
        <label for="task-title">Task Title <span class="required">*</span></label>
        <input type="text" name="title" id="task-title" placeholder="e.g. Wireframe layout sketches" required maxlength="100">
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="task-assignee">Assignee</label>
          <select name="assignedTo" id="task-assignee">
            <option value="">Unassigned</option>
            <% users.forEach(u => { %>
              <option value="<%= u._id %>"><%= u.username %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group col-6">
          <label for="task-status">Status</label>
          <select name="status" id="task-status">
            <option value="To Do">To Do</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-6">
          <label for="task-priority">Priority</label>
          <select name="priority" id="task-priority">
            <option value="Low">Low</option>
            <option value="Medium" selected>Medium</option>
            <option value="High">High</option>
          </select>
        </div>
        <div class="form-group col-6">
          <label for="task-due-date">Due Date</label>
          <input type="date" name="dueDate" id="task-due-date">
        </div>
      </div>

      <div class="form-group">
        <label for="task-desc">Description</label>
        <textarea name="description" id="task-desc" rows="4" placeholder="Detail the criteria for completing this task..." maxlength="1000"></textarea>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="toggleModal('create-task-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Task</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
