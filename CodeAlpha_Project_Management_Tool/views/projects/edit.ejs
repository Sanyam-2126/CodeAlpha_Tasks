<%- include('../partials/header', { pageTitle: 'Edit Project', activeView: 'projects' }) %>

<div class="projects-layout" style="display: block; max-width: 600px; margin: 0 auto;">
  <div class="panel-card">
    <h2><i class="fa-solid fa-pen-to-square"></i> Edit Project Details</h2>
    
    <% if (error) { %>
      <div class="alert alert-error animate-fade-in" style="margin-top: 16px;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/projects/<%= project._id %>/edit" method="POST" class="auth-form" style="padding: 0; margin-top: 24px;">
      <div class="form-group">
        <label for="project-name">Project Name <span class="required">*</span></label>
        <input type="text" name="name" id="project-name" value="<%= project.name %>" required maxlength="100">
      </div>
      <div class="form-group">
        <label for="project-desc">Description</label>
        <textarea name="description" id="project-desc" rows="6" maxlength="500"><%= project.description || '' %></textarea>
      </div>
      
      <div class="modal-footer" style="margin-top: 24px;">
        <a href="/projects/<%= project._id %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
