<%- include('../partials/header.ejs') %>

<div class="admin-header-row">
  <div>
    <h1>Admin Panel - Manage Products</h1>
    <p>Add, edit, or remove catalog items.</p>
  </div>
  <a href="/admin/add-product" class="btn btn-primary">+ Add New Product</a>
</div>

<div class="admin-container">
  <% if (products.length > 0) { %>
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th>Price</th>
            <th>Description</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <td>
                <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="admin-product-thumb">
              </td>
              <td><strong><%= product.title %></strong></td>
              <td><span class="category-badge"><%= product.category %></span></td>
              <td>$<%= product.price.toFixed(2) %></td>
              <td class="admin-td-desc"><%= product.description.length > 60 ? product.description.substring(0, 57) + '...' : product.description %></td>
              <td>
                <div class="admin-actions-cell">
                  <!-- Edit link -->
                  <a href="/admin/edit-product/<%= product._id %>" class="btn btn-outline btn-xs">Edit</a>
                  
                  <!-- Delete form -->
                  <form action="/admin/delete-product" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <button type="submit" class="btn-delete btn-xs">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <span class="empty-icon">📦</span>
      <h3>No Products in Catalog</h3>
      <p>Click below to populate the store with its first item.</p>
      <a href="/admin/add-product" class="btn btn-primary mt-1">Add Product</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer.ejs') %>
